{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "python3 .claude/hooks/reloj.py" } ] }
    ],
    "PreToolUse": [
      { "matcher": "Bash|PowerShell", "hooks": [ { "type": "command", "command": "python3 .claude/hooks/guardia.py" } ] }
    ],
    "PostToolUse": [
      { "matcher": "Write|Edit|MultiEdit", "hooks": [ { "type": "command", "command": "python3 .claude/hooks/anti_mock.py" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "python3 .claude/hooks/verifica.py --hook" } ] }
    ]
  }
}
